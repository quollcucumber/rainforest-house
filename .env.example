# Firebase web app config: Firebase console → Project settings → Your apps → SDK setup
# Copy this file to .env.local and fill in the values. These values are public by design;
# access is controlled by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the app at the local Firebase emulators instead of the real project
VITE_USE_EMULATORS=false
